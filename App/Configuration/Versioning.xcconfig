// Single source of truth for every shipping bundle.
// Xcode/App Store Connect manages the uploaded build number when
// "Manage version and build number" is enabled. This is the local fallback.
// Change APP_MARKETING_VERSION only when creating a new public release.
APP_MARKETING_VERSION = 2.0
APP_BUILD_NUMBER = 18

// iOS 18 pairs with watchOS 11. Keep the app and embedded targets aligned.
APP_IOS_DEPLOYMENT_TARGET = 18.0
APP_WATCHOS_DEPLOYMENT_TARGET = 11.0
