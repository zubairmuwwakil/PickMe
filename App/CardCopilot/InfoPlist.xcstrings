    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location helps PickMe suggest a card at saved merchants. If you enable Wallet Capture, one fresh checkout location may be sent securely to Inunity with that purchase; PickMe never tracks your route."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position aide PickMe à suggérer une carte chez les commerces enregistrés. Si vous activez la capture Wallet, une position récente au moment de l’achat peut être envoyée de façon sécurisée à Inunity avec cet achat; PickMe ne suit jamais votre trajet."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location identifies nearby merchants when you ask. If you enable Wallet Capture, one fresh checkout location may be sent securely to Inunity with that purchase; PickMe never tracks your route."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position repère les commerces à proximité lorsque vous le demandez. Si vous activez la capture Wallet, une position récente au moment de l’achat peut être envoyée de façon sécurisée à Inunity avec cet achat; PickMe ne suit jamais votre trajet."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
