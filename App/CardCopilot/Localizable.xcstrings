    "Delete your PickMe account permanently?" : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer définitivement votre compte PickMe?" } } } },
    "Delete Account and Erase History" : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer le compte et effacer l’historique" } } } },
    "How much are you spending?" : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Quel est le montant de votre achat?" } } } },
