    },
    "Checkout stays available. Add the dedicated PickMe Clerk key and API URL to MoneyTalksConfiguration.swift, then return here to sign in." : {
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement reste disponible. Ajoutez la clé Clerk et l’URL d’API PickMe dans MoneyTalksConfiguration.swift, puis revenez ici pour ouvrir une session."
          }
        }
      }
    },
    "Checkout works without an account. Sign in only to sync cap usage and capture feedback." : {
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paiement fonctionne sans compte. Ouvrez une session seulement pour synchroniser l’utilisation des plafonds et la rétroaction de collecte."
          }
        }
      }
    },
    "Choose every card in your wallet. PickMe only recommends cards you select." : {
      "localizations" : {
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez toutes les cartes de votre portefeuille. PickMe ne recommande que les cartes que vous sélectionnez."
