    ,"Erases your prediction log, your confirmations, and saved merchant locations from this iPhone. Your account and anything already synced to PickMe are not affected." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Efface de cet iPhone votre journal de prédictions, vos confirmations et les emplacements de commerces enregistrés. Votre compte et les données déjà synchronisées avec PickMe ne sont pas touchés." } } } }
    ,"Your prediction log, confirmations, and saved merchant locations are deleted from this iPhone. This cannot be undone. Your account is not affected." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre journal de prédictions, vos confirmations et les emplacements de commerces enregistrés sont supprimés de cet iPhone. Cette action est irréversible. Votre compte n’est pas touché." } } } }
    ,"Deletes your PickMe account and everything stored for it on the server. You choose separately what happens to this iPhone's history." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Supprime votre compte PickMe et toutes les données qui y sont conservées sur le serveur. Vous choisissez séparément ce qui arrive à l’historique de cet iPhone." } } } }
    ,"Everything PickMe stores for you on the server: captured wallet events, cap usage, your saved card setup, and the account record itself." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Tout ce que PickMe conserve pour vous sur le serveur : les événements collectés dans Wallet, l’utilisation des plafonds, la configuration de vos cartes enregistrées et le dossier de compte lui-même." } } } }
    ,"Your PickMe sign-in. You will not be able to sign in again, here or on the web." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre accès PickMe. Vous ne pourrez plus ouvrir de session, ni ici ni sur le Web." } } } }
    ,"Any Wallet Shortcut tokens you created. They stop working immediately." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Tout jeton de raccourci Wallet que vous avez créé. Ils cessent de fonctionner immédiatement." } } } }
    ,"This cannot be undone, and it cannot be restored for you." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Cette action est irréversible et nous ne pouvons pas restaurer les données pour vous." } } } }
    ,"Your prediction log, your confirmations, and saved merchant locations are stored only on this iPhone — they were never uploaded, so deleting your account does not touch them. Choose what happens to them." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre journal de prédictions, vos confirmations et les emplacements de commerces enregistrés sont conservés uniquement sur cet iPhone — ils n’ont jamais été téléversés. La suppression de votre compte ne les touche donc pas. Choisissez ce qui leur arrive." } } } }
    ,"Kept. Checkout keeps working offline with your history intact." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Conservé. Le paiement continue de fonctionner hors ligne avec votre historique intact." } } } }
    ,"Erased from this iPhone along with the account. This cannot be undone either." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Effacé de cet iPhone en même temps que le compte. Cette action est aussi irréversible." } } } }
    ,"Your account, your server data, and this iPhone's history will be deleted. This cannot be undone." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre compte, vos données sur le serveur et l’historique de cet iPhone seront supprimés. Cette action est irréversible." } } } }
    ,"Your account and your server data will be deleted. This iPhone's history is kept. This cannot be undone." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre compte et vos données sur le serveur seront supprimés. L’historique de cet iPhone sera conservé. Cette action est irréversible." } } } }
  },
  "version" : "1.0"
}
