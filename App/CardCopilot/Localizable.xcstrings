    "Entering amounts feeds your value-recovered scoreboard. Skip anytime." : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Les montants saisis alimentent votre tableau de valeur récupérée. Vous pouvez passer cette étape en tout temps." } } } },
    "ESTIMATED RETURN" : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "REMISE ESTIMÉE" } } } },
