{
  "sourceLanguage" : "en",
  "strings" : {
    "Arrival alerts" : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Alertes à l’arrivée" } } } },
    "Get advice when you arrive" : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Recevez un conseil à votre arrivée" } } } },
    "PickMe can recognize arrival at up to 20 merchants you have already saved, then suggest a card before you pay." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "PickMe peut reconnaître votre arrivée chez un maximum de 20 commerces que vous avez déjà enregistrés, puis vous suggérer une carte avant le paiement." } } } },
    "Location is used only for arrival detection at your saved merchants." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Votre position sert uniquement à détecter votre arrivée chez les commerces que vous avez enregistrés." } } } },
    "It does not continuously track your route, and your location never leaves this phone." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "L’app ne suit pas votre trajet en continu et votre position ne quitte jamais cet iPhone." } } } },
    "You can keep using manual checkout if you decline." : { "comment" : "human review before public launch", "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Vous pouvez continuer d’utiliser le paiement manuel si vous refusez." } } } },
