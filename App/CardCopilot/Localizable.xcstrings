    },
    "Choose up to three categories currently selected on your Tangerine account. Leave all unselected if you are not sure." : { "localizations" : { "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez jusqu’à trois catégories actuellement sélectionnées dans votre compte Tangerine. Ne sélectionnez rien si vous n’êtes pas certain." } } } },
