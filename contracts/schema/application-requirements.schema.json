{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pickme.local/contracts/application-requirements.schema.json",
  "title": "PickMe application income requirements",
  "description": "Issuer-confirmed financial prerequisites for acquisition candidates. These facts assess published income paths only; they never predict approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationRequirementsVersion", "verifiedAt", "requirements"],
  "properties": {
    "applicationRequirementsVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "verifiedAt": { "type": "string", "format": "date" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/cardRequirement" }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "enum": ["CAD", "USD"] }
      }
    },
    "incomeOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "amount"],
      "properties": {
        "type": { "enum": ["individualAnnualIncome", "householdAnnualIncome"] },
        "operator": { "enum": ["atLeast", "greaterThan"] },
        "amount": { "$ref": "#/$defs/money" }
      }
    },
    "financialRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationStatus", "semantics", "options"],
      "properties": {
        "publicationStatus": { "enum": ["published", "noIssuerPublishedMinimumFound"] },
        "semantics": { "enum": ["any", "unknown"] },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/incomeOption" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "publicationStatus": { "const": "published" } } },
          "then": {
            "properties": {
              "semantics": { "const": "any" },
              "options": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "publicationStatus": { "const": "noIssuerPublishedMinimumFound" } } },
          "then": {
            "properties": {
              "semantics": { "const": "unknown" },
              "options": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "scope", "verifiedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "scope": { "enum": ["cardSpecific", "cardSpecificApplication"] },
        "verifiedAt": { "type": "string", "format": "date" }
      }
    },
    "cardRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId", "coverage", "financialRequirements", "sources"],
      "properties": {
        "cardId": { "type": "string", "minLength": 1 },
        "coverage": { "enum": ["completePublishedSet", "partialPublishedSet"] },
        "financialRequirements": { "$ref": "#/$defs/financialRequirements" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
