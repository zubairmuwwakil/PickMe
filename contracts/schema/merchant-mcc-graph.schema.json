{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zubairmuwwakil/PickMe/contracts/schema/merchant-mcc-graph.schema.json",
  "title": "PickMe merchant MCC graph seed",
  "description": "Editorial priors and low-confidence public location evidence used to bootstrap PickMe's learning merchant-MCC graph. Priors are never payment-network observations.",
  "type": "object",
  "required": [
    "graphVersion",
    "generatedAt",
    "categories",
    "profiles",
    "merchants",
    "observations"
  ],
  "additionalProperties": false,
  "properties": {
    "graphVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "_provenance": {
      "type": "object"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "primaryMcc",
          "candidateMccs",
          "weights",
          "confidence",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "primaryMcc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "candidateMccs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          },
          "weights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "merchants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tier",
          "category",
          "profile"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "merchantId",
          "mcc",
          "sourceType",
          "sourceUrl",
          "confidence",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "merchantId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "mcc": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "community_directory_location",
              "user_entered_exact_mcc",
              "reward_outcome_inference",
              "network_observed"
            ]
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scope": {
            "type": "object",
            "required": [
              "country"
            ],
            "additionalProperties": false,
            "properties": {
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "address": {
                "type": "string"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "inStore",
                  "online",
                  "app",
                  "unknown"
                ]
              },
              "network": {
                "type": "string",
                "enum": [
                  "amex",
                  "visa",
                  "mastercard",
                  "discover",
                  "interac",
                  "unknown"
                ]
              }
            }
          },
          "observedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}